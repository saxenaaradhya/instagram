# Required: password for /admin
ADMIN_PASSWORD=change-me
# Required: long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-with-a-long-random-string
# Production on Vercel: create a Blob store and paste its token. Leave empty locally to use ./data.
BLOB_READ_WRITE_TOKEN=
# Optional: max upload size per PDF in MB (default 50)
MAX_UPLOAD_MB=50
